# ─────────────────────────────────────────────────────────────────────────────
# DATABASE — Generic PostgreSQL (any provider, just change this one URL)
# ─────────────────────────────────────────────────────────────────────────────
#
# Works with ANY PostgreSQL-compatible database. No code changes needed.
# Just swap the URL and the app connects to the new database.
#
# Local Docker Postgres:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lms_db
#
# Neon (add ?sslmode=require):
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/lms_db?sslmode=require
#
# Supabase (port 5432 for direct, 6543 for the pgbouncer pooler):
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0.ap-south-1.pooler.supabase.com:6543/postgres
#
# Railway:
# DATABASE_URL=postgresql://postgres:password@monorail.proxy.rlwy.net:12345/railway
#
# AWS RDS:
# DATABASE_URL=postgresql://admin:password@mydb.cluster.region.rds.amazonaws.com:5432/lms_db
#
# Render:
# DATABASE_URL=postgresql://user:password@dpg-xxx.oregon-postgres.render.com/lms_db
#
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lms_db

# ─────────────────────────────────────────────────────────────────────────────
# AUTH (Auth.js v5)
# ─────────────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Canonical app origin, no trailing slash. Used in email links and redirects.
APP_URL=http://localhost:3000

# Google OAuth for SSO. Unset means the provider is hidden from the sign-in page.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# UPSTASH REDIS (rate limiting)
# ─────────────────────────────────────────────────────────────────────────────
# Both values are required; rate limiting stays off unless both are present.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# UPSTASH QSTASH (scheduled jobs: session reminders, report generation)
# ─────────────────────────────────────────────────────────────────────────────
# The signing keys are only required to verify inbound webhooks.
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# ABLY (realtime chat fan-out)
# ─────────────────────────────────────────────────────────────────────────────
# Chat messages are stored in Postgres; Ably only pushes "new message" signals.
# Without a key the client falls back to polling, so local dev needs nothing.
ABLY_API_KEY=
# Poll interval in ms used when Ably is not configured.
CHAT_POLL_INTERVAL_MS=5000

# ─────────────────────────────────────────────────────────────────────────────
# ANTHROPIC (AI monthly progress reports)
# ─────────────────────────────────────────────────────────────────────────────
# Without a key, reports are generated from a deterministic template so the
# whole review-and-send flow still works end to end.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL (transactional, via any SMTP provider)
# ─────────────────────────────────────────────────────────────────────────────
# Works with Gmail, SES, Resend SMTP, Postmark, or a local Mailpit instance.
# In development with no SMTP_HOST, email is logged to the database instead of
# being sent. Use Mailpit locally to actually read the messages:
#   docker run -p 1025:1025 -p 8025:8025 axllent/mailpit
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=LMS Platform <noreply@example.com>

# ─────────────────────────────────────────────────────────────────────────────
# ZOOM (Server-to-Server OAuth for sessions + attendance webhooks)
# ─────────────────────────────────────────────────────────────────────────────
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE CALENDAR (two-way sync per educator)
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
GOOGLE_CALENDAR_WEBHOOK_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# CLOUDFLARE R2 / S3 (avatars, course materials, report PDFs)
# ─────────────────────────────────────────────────────────────────────────────
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=

# ─────────────────────────────────────────────────────────────────────────────
# RAZORPAY (INR payments) — not yet implemented
# ─────────────────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# DEVELOPMENT
# ─────────────────────────────────────────────────────────────────────────────
# Auto-provision demo accounts on first login. Never enable in production.
ENABLE_DEMO_ACCOUNTS=false
